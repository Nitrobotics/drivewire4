    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <encoding>windows-1252</encoding>
                </configuration>
            </plugin>

            <!--
              Generate a tiny class that records which SWT platform this build targeted.
              This is informational (packaging/diagnostics). Runtime behavior should still
              rely on System.getProperty("os.name") / "os.arch".
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/dw</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>generate-buildtarget</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-sources/dw/com/groupunix/drivewire/util"/>
                                <echo file="${project.build.directory}/generated-sources/dw/com/groupunix/drivewire/util/BuildTarget.java" encoding="UTF-8"><![CDATA[
package com.groupunix.drivewire.util;

/**
 * Generated at build time.
 *
 * The value reflects the SWT platform selected by Maven (see -Dswt.platform).
 * This is intended for logging/diagnostics and packaging decisions.
 */
public final class BuildTarget {
    private BuildTarget() {}

    public static final String SWT_PLATFORM = "${swt.platform.effective}";
    public static final String SWT_ARTIFACT_ID = "${swt.artifactId}";
    public static final String SWT_VERSION = "${swt.version}";
}
]]></echo>
                            </target>
                        </configuration>
                    </execution>

                    <execution>
                        <id>cleanup-old-swt</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <!-- Delete old Carbon-based SWT fragments (pre-Cocoa) -->
                                <delete verbose="true" failonerror="false">
                                    <fileset dir="${project.build.directory}/lib" includes="macosx-*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="*carbon*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="x86-*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="x86_64-*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="aarch64-*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="win32-*.jar"/>
                                    <fileset dir="${project.build.directory}/lib" includes="linux-*.jar"/>
                                </delete>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Exec plugin for running -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.groupunix.drivewireui.MainWin</mainClass>
                    <includeProjectDependencies>true</includeProjectDependencies>
                    <includePluginDependencies>false</includePluginDependencies>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/lib/swing2swt-1.6.0.jar</additionalClasspathElement>
                    </additionalClasspathElements>
                    <systemProperties>
                        <systemProperty>
                            <key>java.library.path</key>
                            <value>${project.basedir}/lib</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>

            <!-- JAR plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
          <finalName>drivewire4</finalName>
                    <archive>
                        <manifest>
                            <mainClass>com.groupunix.drivewireui.MainWin</mainClass>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                        </manifest>
                        <manifestEntries>
                            <Class-Path>lib/swing2swt-1.6.0.jar</Class-Path>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Copy dependencies to lib/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <!-- Exclude old/conflicting SWT fragments by groupId -->
                            <excludeGroupIds>org.eclipse.swt.cocoa.macosx,org.eclipse.swt.gtk.linux,org.eclipse.swt.win32.win32,org.eclipse.swt</excludeGroupIds>
                            <!-- Also exclude by artifactId pattern - includes old naming conventions -->
                            <excludeArtifactIds>x86_64,aarch64,macosx,win32,linux,org.eclipse.swt</excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy swing2swt-1.6.0.jar to target/lib -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-swing2swt</id>
                        <phase>package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/lib</directory>
                                    <includes>
                                        <include>swing2swt-1.6.0.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Create a *platform-specific* distribution ZIP.

              Build examples:
                mvn -DskipTests package                         (host platform)
                mvn -DskipTests -Dswt.platform=linux-aarch64 package

              Output:
                target/drivewire4-<version>-<swt.platform.effective>.zip
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <finalName>${project.artifactId}-${project.version}-${swt.platform.effective}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <formats>
                        <format>zip</format>
                    </formats>
                    <!-- Assembly plugin requires an explicit descriptor. -->
                    <descriptors>
                        <descriptor>src/assembly/dist.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>make-dist-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- Additional repositories -->
    <repositories>
        <repository>
            <id>nuiton-thirdparty</id>
            <name>Nuiton Thirdparty Repository</name>
            <url>https://nexus.nuiton.org/nexus/content/repositories/thirdparty/</url>
        </repository>
    </repositories>

    <!--
      SWT is platform-specific (native code). This build supports *all* SWT platforms by
      selecting exactly ONE SWT artifact per build.

      - Default (no -Dswt.platform): selects the host OS/arch.
      - Cross-build: pass -Dswt.platform=<value> to select another platform's SWT jar.

      Example (build on Linux, target macOS Apple Silicon):
        mvn -Dswt.platform=macos-aarch64 clean package
    -->
    <profiles>
        <!-- ============================ -->
        <!-- Explicit selection via -Dswt.platform -->
        <!-- ============================ -->
        <profile>
            <id>platform-linux-x86_64</id>
            <activation>
                <property>
                    <name>swt.platform</name>
                    <value>linux-x86_64</value>
                </property>
            </activation>
            <properties>
                <swt.platform.effective>linux-x86_64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.gtk.linux.x86_64</swt.artifactId>
            </properties>
        </profile>

        <profile>
            <id>platform-linux-aarch64</id>
            <activation>
                <property>
                    <name>swt.platform</name>
                    <value>linux-aarch64</value>
                </property>
            </activation>
            <properties>
                <swt.platform.effective>linux-aarch64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.gtk.linux.aarch64</swt.artifactId>
            </properties>
        </profile>

        <profile>
            <id>platform-macos-x86_64</id>
            <activation>
                <property>
                    <name>swt.platform</name>
                    <value>macos-x86_64</value>
                </property>
            </activation>
            <properties>
                <swt.platform.effective>macos-x86_64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.cocoa.macosx.x86_64</swt.artifactId>
            </properties>
        </profile>

        <profile>
            <id>platform-macos-aarch64</id>
            <activation>
                <property>
                    <name>swt.platform</name>
                    <value>macos-aarch64</value>
                </property>
            </activation>
            <properties>
                <swt.platform.effective>macos-aarch64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.cocoa.macosx.aarch64</swt.artifactId>
            </properties>
        </profile>

        <profile>
            <id>platform-windows-x86_64</id>
            <activation>
                <property>
                    <name>swt.platform</name>
                    <value>windows-x86_64</value>
                </property>
            </activation>
            <properties>
                <swt.platform.effective>windows-x86_64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.win32.win32.x86_64</swt.artifactId>
            </properties>
        </profile>

        <!-- ============================ -->
        <!-- Default selection (only when -Dswt.platform is NOT set) -->
        <!-- ============================ -->
        <profile>
            <id>auto-linux-x86_64</id>
            <activation>
                <property>
                    <name>!swt.platform</name>
                </property>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <swt.platform.effective>linux-x86_64</swt.platform.effective>
                <swt.artifactId>org.eclipse.swt.gtk.linux.x86_64</swt.artifactId>
            </properties>
        </profile>

        <profile>
            <id>auto-linux-aarch64</id>
