<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 https://maven.apache.org/xsd/assembly-1.1.3.xsd">

  <id>dist</id>

  <formats>
    <format>zip</format>
  </formats>

  <includeBaseDirectory>true</includeBaseDirectory>
  <baseDirectory>${project.artifactId}-${project.version}-${swt.platform.effective}</baseDirectory>

  <fileSets>
    <!-- App jar -->
    <fileSet>
      <directory>${project.build.directory}</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>drivewire4.jar</include>
      </includes>
    </fileSet>

    <!-- Dependencies (includes selected SWT fragment) -->
    <fileSet>
      <directory>${project.build.directory}/lib</directory>
      <outputDirectory>/lib</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>

    <!-- Config + UI resources + launch scripts -->
    <fileSet>
      <directory>${project.basedir}</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>config.xml</include>
        <include>drivewireUI.xml</include>
        <include>dw4_icon.png</include>
        <include>help.xml</include>
        <include>master.xml</include>
        <include>hdbdw3cc1.wav</include>
        <include>hdbdw3cc2.wav</include>
        <include>hdbdw3cc3.wav</include>
        <include>README.md</include>
        <include>run-*.sh</include>
        <include>run-windows.bat</include>
        <include>buildall.sh</include>
        <include>installers/**</include>
        <include>dw4_icon.png</include>
        <include>dw4_icon.ico</include>
        <include>help.xml</include>
        <include>master.xml</include>
        <include>hdbdw3cc1.wav</include>
        <include>hdbdw3cc2.wav</include>
        <include>hdbdw3cc3.wav</include>
        <include>hdb-dos/**</include>
      </includes>
      <fileMode>0755</fileMode>
    </fileSet>


<!-- Bundled JRE placeholder directory (not hidden) -->
<fileSet>
  <directory>${project.basedir}/jre</directory>
  <outputDirectory>/jre</outputDirectory>
  <includes>
    <include>**/*</include>
  </includes>
</fileSet>
  </fileSets>

</assembly>
